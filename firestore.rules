rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de verificación de usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regla para configuración del sistema y ciclo escolar activo
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /configuracion_sistema/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reglas para Roles y Permisos RBAC
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /rolesConfig/{roleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reglas para Docentes, Usuarios y Datos Personales
    match /docentes/{docenteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /datos_personales/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Reglas para Clases, Pensum y Asignaciones Académicas
    match /clases/{claseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /pensum/{asgId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /pensumCatalog/{subjectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reglas para Estudiantes y Notas / Calificaciones
    match /estudiantes/{studentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /notas/{notaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /gradesList/{gradeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /grados_secciones/{gradeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /maestros_guias/{guideId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Estado escolar institucional unificado y auditoría
    match /encc_school_state/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Denegación por defecto para cualquier documento no contemplado
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
