rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Modelo de Datos y Control de Acceso Asumido
    // ===============================================================
    // Colección de lista blanca institucional: /authorized_uids/{uid}
    //   - active: bool (requerido, debe ser true para conceder acceso)
    //   - role: string (ej. 'admin', 'director', 'docente', 'secretaria')
    //
    // Niveles de acceso:
    //   - Personal autorizado (isAuthorizedStaff): lectura general y
    //     escritura en colecciones operativas académicas.
    //   - Personal de Permisos Docentes (isTeacherPermissionsStaff):
    //     acceso exclusivo a /teacherPermissions/{permId} para Auxiliatura,
    //     Secretaría, Dirección y Administración (denegado a docentes y estudiantes).
    //   - Administración / Dirección (isAdminOrDirector): gestión de
    //     lista blanca, configuración, RBAC y usuarios.
    //   - Por defecto (fail-closed): cualquier ruta no declarada se deniega.
    //
    // Colección: /teacherPermissions/{permId}
    //   - id, cycle, teacherId, teacherName, startDate, endDate, duration,
    //     type, supportDoc, createdBy, createdByRole, createdAt, updatedAt: string (requeridos)
    //   - days: int (requerido, 1..366)
    //   - renglon, customType, reason: string (opcionales, con límites de tamaño)
    //   - Campos inmutables en actualización: id, createdAt, createdBy, createdByRole
    // ===============================================================

    // Verifica que el usuario autenticado pertenezca a la lista blanca institucional y esté activo
    function isAuthorizedStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/authorized_uids/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authorized_uids/$(request.auth.uid)).data.active == true;
    }

    // Verifica que el usuario autorizado tenga rol de administrador o director
    function isAdminOrDirector() {
      return isAuthorizedStaff() &&
        get(/databases/$(database)/documents/authorized_uids/$(request.auth.uid)).data.role in ['admin', 'director'];
    }

    // Verifica que el personal autorizado tenga rol habilitado para gestionar Permisos Docentes
    // (Excluye estrictamente a docentes y estudiantes a nivel de servidor)
    function isTeacherPermissionsStaff() {
      return isAuthorizedStaff() &&
        get(/databases/$(database)/documents/authorized_uids/$(request.auth.uid)).data.role in [
          'admin', 'super_usuario', 'director', 'direccion',
          'secretaria', 'profesor_auxiliar', 'auxiliar', 'auxiliatura'
        ];
    }

    // Valida esquema, tipos y límites de tamaño para registros de Permisos Docentes
    function isValidTeacherPermission(data, permId) {
      return data.keys().hasOnly([
          'id', 'cycle', 'teacherId', 'teacherName', 'renglon',
          'startDate', 'endDate', 'days', 'duration', 'type',
          'customType', 'reason', 'supportDoc', 'createdBy',
          'createdByRole', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id', 'cycle', 'teacherId', 'teacherName',
          'startDate', 'endDate', 'days', 'duration', 'type',
          'supportDoc', 'createdBy', 'createdByRole', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == permId && data.id.size() > 0 && data.id.size() <= 100 &&
        data.cycle is string && data.cycle.size() > 0 && data.cycle.size() <= 20 &&
        data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 120 &&
        data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 200 &&
        (!('renglon' in data) || (data.renglon is string && data.renglon.size() <= 120)) &&
        data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.endDate >= data.startDate &&
        data.days is int && data.days >= 1 && data.days <= 366 &&
        data.duration is string && data.duration.size() > 0 && data.duration.size() <= 100 &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
        (!('customType' in data) || (data.customType is string && data.customType.size() <= 120)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 2000)) &&
        data.supportDoc is string && data.supportDoc.size() > 0 && data.supportDoc.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 150 &&
        data.createdByRole is string && data.createdByRole.size() > 0 && data.createdByRole.size() <= 50 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40;
    }

    // Lista blanca institucional de UIDs autorizados
    match /authorized_uids/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdminOrDirector());
      allow write: if isAdminOrDirector();
    }

    // Reglas para configuración del sistema y ciclo escolar activo (escritura solo Admin/Director)
    match /configuracion/{document=**} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    // Registro de asistencia accesible para docentes y personal auxiliar autorizado
    match /config/asistencia {
      allow read, write: if isAuthorizedStaff();
    }
    match /config/{document=**} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    match /configuracion_sistema/{document=**} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }

    // Reglas para Roles y Permisos RBAC (escritura solo Admin/Director)
    match /roles/{roleId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    match /rolesConfig/{roleId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }

    // Reglas para Usuarios (escritura solo Admin/Director)
    match /users/{userId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }

    // Reglas para Docentes y Datos Personales (operativas)
    match /docentes/{docenteId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /datos_personales/{docId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }

    // Reglas para Clases, Pensum y Asignaciones Académicas
    match /clases/{claseId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /pensum/{asgId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /pensumCatalog/{subjectId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }

    // Reglas para Estudiantes y Notas / Calificaciones
    match /estudiantes/{studentId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /students/{studentId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /notas/{notaId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /calificaciones/{gradeId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /gradesList/{gradeId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /grados_secciones/{gradeId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }
    match /maestros_guias/{guideId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }

    // Estado escolar institucional unificado y auditoría
    match /encc_school_state/{document=**} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
    }

    // Reglas operativas de asistencia, disciplina, permisos y gestión académica
    match /attendanceAlerts/{alertId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /studentPermissions/{permId} {
      allow read, write: if isAuthorizedStaff();
    }
    // Control de Permisos Docentes (exclusivo para Auxiliatura, Secretaría, Dirección y Admin;
    // docentes y estudiantes quedan estrictamente denegados en el servidor)
    match /teacherPermissions/{permId} {
      allow read: if isTeacherPermissionsStaff();
      allow create: if isTeacherPermissionsStaff() &&
        isValidTeacherPermission(request.resource.data, permId);
      allow update: if isTeacherPermissionsStaff() &&
        isValidTeacherPermission(request.resource.data, permId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdByRole == resource.data.createdByRole;
      allow delete: if isTeacherPermissionsStaff();
    }
    match /disciplina/{docId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /disciplineReports/{reportId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /studentAnnotations/{noteId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /exoneraciones/{exonId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /gradeEditRequests/{reqId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /courseBitacora/{entryId} {
      allow read, write: if isAuthorizedStaff();
    }
    match /config_ponderaciones/{docId} {
      allow read, write: if isAuthorizedStaff();
    }

    // Catálogos administrativos institucionales (escritura solo Admin/Director)
    match /careers/{careerId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    match /cycles/{cycleId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    match /ciclos/{cycleId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }
    match /secciones/{sectionId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdminOrDirector();
    }

    // Denegación estricta por defecto (fail-closed) para cualquier documento no contemplado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
