rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verificación de usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regla crítica para colección de configuración del sistema y bimestre activo
    match /configuracion/{document=**} {
      allow read, write: if request.auth != null || true;
    }
    match /config/{document=**} {
      allow read, write: if request.auth != null || true;
    }
    match /configuracion_sistema/{document=**} {
      allow read, write: if request.auth != null || true;
    }

    // Reglas para Roles y Permisos
    match /roles/{roleId} {
      allow read, write: if request.auth != null || true;
    }
    match /rolesConfig/{roleId} {
      allow read, write: if request.auth != null || true;
    }

    // Reglas para Docentes, Usuarios y Datos Personales
    match /docentes/{docenteId} {
      allow read, write: if request.auth != null || true;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null || true;
    }
    match /datos_personales/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Reglas para Clases, Pensum y Asignaciones
    match /clases/{claseId} {
      allow read, write: if request.auth != null || true;
    }
    match /pensum/{asgId} {
      allow read, write: if request.auth != null || true;
    }
    match /pensumCatalog/{subjectId} {
      allow read, write: if request.auth != null || true;
    }

    // Reglas para Estudiantes y Notas / Calificaciones
    match /estudiantes/{studentId} {
      allow read, write: if request.auth != null || true;
    }
    match /students/{studentId} {
      allow read, write: if request.auth != null || true;
    }
    match /notas/{notaId} {
      allow read, write: if request.auth != null || true;
    }
    match /gradesList/{gradeId} {
      allow read, write: if request.auth != null || true;
    }
    match /grados_secciones/{gradeId} {
      allow read, write: if request.auth != null || true;
    }
    match /maestros_guias/{guideId} {
      allow read, write: if request.auth != null || true;
    }

    // Estado escolar institucional unificado
    match /encc_school_state/{document=**} {
      allow read, write: if request.auth != null || true;
    }

    // Acceso general para desarrollo y usuarios autenticados
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
