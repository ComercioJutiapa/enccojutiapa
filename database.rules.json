{
  "rules": {
    ".read": true,
    ".write": "auth != null || (newData.exists() && !data.exists())",
    "encc_school_state": {
      ".read": true,
      ".write": "auth != null || (newData.exists() && data.exists())",
      ".indexOn": [
        "lastModified",
        "activeCycle"
      ],
      "rolesConfig": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "users": {
        ".read": true,
        ".write": "auth != null || (newData.exists() && newData.hasChildren(['username', 'role']))"
      },
      "pensum": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "pensumCatalog": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "students": {
        ".read": true,
        ".write": "auth != null || (newData.exists() && (newData.isObject() || newData.isArray()))",
        ".indexOn": [
          "code",
          "cui",
          "gradeCode",
          "section",
          "status"
        ]
      },
      "gradesList": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "activityAuditLog": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".indexOn": [
          "timestamp",
          "user",
          "action"
        ]
      },
      "lockoutRecords": {
        ".read": true,
        ".write": true
      }
    },
    "attendance": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "date",
        "gradeCode",
        "section",
        "month"
      ]
    },
    "exoneraciones": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "studentId",
        "gradeCode",
        "status"
      ]
    },
    "permissions": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "studentId",
        "date",
        "status"
      ]
    },
    "auxiliatura_alerts": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "timestamp",
        "status",
        "studentId"
      ]
    },
    "historico": {
      ".read": true,
      ".write": "auth != null || (!data.exists() && newData.exists())",
      ".indexOn": [
        "cycle",
        "archivedAt"
      ]
    }
  }
}
