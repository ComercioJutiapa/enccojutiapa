{
  "rules": {
    "encc_school_state": {
      ".read": true,
      ".write": "auth != null || (newData.exists() && data.exists())",
      ".indexOn": [
        "lastModified",
        "activeCycle"
      ],
      "rolesConfig": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "users": {
        ".read": true,
        ".write": "auth != null || (newData.exists() && newData.hasChildren(['username', 'role']))"
      },
      "pensum": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "pensumCatalog": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "students": {
        ".read": true,
        ".write": "auth != null || newData.exists()",
        ".indexOn": [
          "code",
          "cui",
          "gradeCode",
          "section",
          "status"
        ]
      },
      "gradesList": {
        ".read": true,
        ".write": "auth != null || newData.exists()"
      },
      "activityAuditLog": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".indexOn": [
          "timestamp",
          "user",
          "action"
        ]
      },
      "lockoutRecords": {
        ".read": true,
        ".write": true
      }
    },
    "students": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "code",
        "cui",
        "gradeCode",
        "section",
        "status",
        "carne",
        "personalCode"
      ]
    },
    "pensum": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "pensumCatalog": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "gradesList": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "roles": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "rolesConfig": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "users": {
      ".read": true,
      ".write": "auth != null || (newData.exists() && newData.hasChildren(['username', 'role']))"
    },
    "secciones": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "config": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "cycles": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "gradingConfigs": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "attendance": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "date",
        "gradeCode",
        "section",
        "month"
      ]
    },
    "attendanceRecords": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "attendancePermissionsMeta": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "attendanceAlerts": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "timestamp",
        "status",
        "studentId",
        "date"
      ]
    },
    "studentAnnotations": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "studentId",
        "date",
        "timestamp"
      ]
    },
    "exoneraciones": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "studentId",
        "gradeCode",
        "status"
      ]
    },
    "permissions": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "studentId",
        "date",
        "status"
      ]
    },
    "auxiliatura_alerts": {
      ".read": true,
      ".write": "auth != null || newData.exists()",
      ".indexOn": [
        "timestamp",
        "status",
        "studentId"
      ]
    },
    "userAlertsDismissed": {
      ".read": true,
      ".write": "auth != null || newData.exists()"
    },
    "lockoutRecords": {
      ".read": true,
      ".write": true
    },
    "historico": {
      ".read": true,
      ".write": "auth != null || (!data.exists() && newData.exists())",
      ".indexOn": [
        "cycle",
        "archivedAt"
      ]
    }
  }
}
